<script>
(function(){
  'use strict';

  /* ── MAIN TABS ── */
  var mainTabs = document.querySelectorAll('.tab');
  var pages = document.querySelectorAll('.page');
  for (var i = 0; i < mainTabs.length; i++) {
    mainTabs[i].addEventListener('click', function(){
      for (var j = 0; j < mainTabs.length; j++) mainTabs[j].classList.remove('active');
      for (var k = 0; k < pages.length; k++) pages[k].classList.remove('active');
      this.classList.add('active');
      var target = document.getElementById(this.getAttribute('data-tab'));
      if (target) target.classList.add('active');
      window.scrollTo({top:0, behavior:'smooth'});
      runSearch();
    });
  }

  /* ── SUB TABS (scoped per group) ── */
  var subTabGroups = document.querySelectorAll('.subtabs');
  for (var g = 0; g < subTabGroups.length; g++) {
    (function(group){
      var tabs = group.querySelectorAll('.subtab');
      var page = group.closest('.page');
      for (var t = 0; t < tabs.length; t++) {
        tabs[t].addEventListener('click', function(){
          for (var a = 0; a < tabs.length; a++) tabs[a].classList.remove('active');
          var subs = page.querySelectorAll('.subpage');
          for (var b = 0; b < subs.length; b++) subs[b].classList.remove('active');
          this.classList.add('active');
          var target = document.getElementById('sub-' + this.getAttribute('data-subtab'));
          if (target) target.classList.add('active');
          runSearch();
        });
      }
    })(subTabGroups[g]);
  }

  /* ── THEME ── */
  var themeBtn = document.getElementById('themeToggle');
  try {
    if (localStorage.getItem('mep-theme') === 'dark') {
      document.documentElement.classList.add('dark');
    }
  } catch(e){}
  themeBtn.addEventListener('click', function(){
    document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('mep-theme',
        document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    } catch(e){}
  });

  /* ── SEARCH ── */
  var searchInput = document.getElementById('search');

  function runSearch(){
    var activePage = document.querySelector('.page.active');
    if (!activePage) return;

    // Skip search filtering inside the Workbook Logic page
    if (activePage.id === 'logic') return;

    var q = searchInput.value.trim().toLowerCase();

    var scope = activePage;
    var activeSub = activePage.querySelector('.subpage.active');
    if (activeSub) scope = activeSub;

    var cards = scope.querySelectorAll('.activity');
    var visible = 0;
    for (var i = 0; i < cards.length; i++) {
      var card = cards[i];
      var hay = ((card.getAttribute('data-search') || '') + ' ' + card.textContent).toLowerCase();
      var ok = !q || hay.indexOf(q) !== -1;
      card.style.display = ok ? '' : 'none';
      if (ok) visible++;
    }

    var emptyId = null;
    if (activePage.id === 'div02') emptyId = 'empty02';
    else if (activePage.id === 'div04') emptyId = 'empty04';
    else if (activePage.id === 'div15') emptyId = (scope.id === 'sub-elec') ? 'emptyElec' : 'emptyMech';

    if (emptyId) {
      var emptyEl = document.getElementById(emptyId);
      if (emptyEl) {
        if (visible === 0) emptyEl.classList.add('show');
        else emptyEl.classList.remove('show');
      }
    }
  }

  var timer;
  searchInput.addEventListener('input', function(){
    clearTimeout(timer);
    timer = setTimeout(runSearch, 120);
  });

  /* ── KEYBOARD ── */
  document.addEventListener('keydown', function(e){
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      searchInput.focus();
    }
    if (e.key === 'Escape' && document.activeElement === searchInput) {
      searchInput.value = '';
      runSearch();
      searchInput.blur();
    }
  });

  runSearch();
})();
</script>
