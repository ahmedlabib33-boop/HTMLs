<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MEP Coding System — Workbook Logic + Divisions 02 · 04 · 15 &amp; 16</title>
<style>
  :root{
    --navy:#102a43; --ink:#1f2933; --muted:#52606d; --line:#d9e2ec; --soft:#f5f7fa;
    --accent:#16697a; --gold:#b28a38;
    --pass:#1e7e46; --pass-tint:#e6f4ea;
    --revise:#b7791f; --revise-tint:#fdf3e0;
    --hold:#c0392b; --hold-tint:#fdecea;
    --plain-tint:#eef7f8; --contract-tint:#f8fafc; --gold-tint:#fbf3e3; --badge-tint:#f0f4f8;
    --mat:#b28a38; --mat-tint:#fbf3e3;
    --sub:#c0392b; --sub-tint:#fdecea;
    --crew:#1e7e46; --crew-tint:#e6f4ea;
    --eq:#6b46c1; --eq-tint:#f3f0fa;
    --bg:#ffffff; --panel:#ffffff; --bg-soft:#f5f7fa;
    --radius:10px; --radius-sm:8px;
    --shadow:0 1px 2px rgba(16,42,67,.04);
    --shadow2:0 4px 14px rgba(16,42,67,.08);
  }
  html.dark{
    --navy:#e6edf3; --ink:#e6edf3; --muted:#8fa3b3; --line:#1e3a52; --soft:#0b1f33;
    --accent:#4dc0d4; --gold:#d4b25c;
    --pass:#4ade80; --pass-tint:#0d2e1e;
    --revise:#fbbf24; --revise-tint:#2a2413;
    --hold:#f87171; --hold-tint:#2a1414;
    --plain-tint:#0d2c33; --contract-tint:#0f2338; --gold-tint:#2a2413; --badge-tint:#102a43;
    --mat:#d4b25c; --mat-tint:#2a2413;
    --sub:#f87171; --sub-tint:#2a1414;
    --crew:#4ade80; --crew-tint:#0d2e1e;
    --eq:#a78bfa; --eq-tint:#1e1838;
    --bg:#0b1a2b; --panel:#102a43; --bg-soft:#0f2338;
    --shadow:0 1px 2px rgba(0,0,0,.3);
    --shadow2:0 4px 14px rgba(0,0,0,.5);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{-webkit-text-size-adjust:100%; scroll-behavior:smooth;}
  body{font-family:'Aptos','Segoe UI',system-ui,-apple-system,Arial,sans-serif; background:var(--bg); color:var(--ink); font-size:14px; line-height:1.5; transition:background .2s, color .2s; min-height:100vh; -webkit-font-smoothing:antialiased;}
  a{color:var(--accent); text-decoration:none;}
  button{font-family:inherit; cursor:pointer; border:none; background:none; color:inherit;}

  /* HEADER */
  .app-header{position:sticky; top:0; z-index:50; background:var(--panel); border-bottom:1px solid var(--line);}
  .topbar{max-width:1320px; margin:0 auto; padding:12px 18px; display:flex; align-items:center; gap:12px; flex-wrap:wrap;}
  .brand{display:flex; align-items:center; gap:10px; flex-shrink:0;}
  .brand-mark{width:38px; height:38px; border-radius:9px; background:linear-gradient(135deg,#0b2239,#16697a); color:#fff; display:grid; place-items:center; font-weight:800; font-size:13px; box-shadow:0 3px 10px rgba(22,105,122,.28);}
  .brand-title{font-size:14.5px; font-weight:700; line-height:1.1;}
  .brand-sub{font-size:10.5px; color:var(--muted); margin-top:2px;}
  .search{flex:1 1 200px; min-width:0; position:relative;}
  .search input{width:100%; height:38px; padding:0 14px 0 38px; border:1px solid var(--line); border-radius:999px; background:var(--bg-soft); color:var(--ink); font-family:inherit; font-size:13px; outline:none; transition:.15s;}
  .search input:focus{border-color:var(--accent); background:var(--panel); box-shadow:0 0 0 3px rgba(22,105,122,.12);}
  .search-icon{position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--muted); pointer-events:none;}
  .icon-btn{width:38px; height:38px; border-radius:50%; border:1px solid var(--line); background:var(--panel); color:var(--ink); display:grid; place-items:center; transition:.15s; flex-shrink:0;}
  .icon-btn:hover{border-color:var(--accent); color:var(--accent);}
  .icon-sun{display:none;}
  html.dark .icon-sun{display:block;}
  html.dark .icon-moon{display:none;}

  /* TABS */
  .tabs{max-width:1320px; margin:0 auto; padding:0 18px 12px; display:flex; gap:8px; overflow-x:auto; scrollbar-width:none;}
  .tabs::-webkit-scrollbar{display:none;}
  .tab{display:inline-flex; align-items:center; gap:8px; padding:8px 16px; border-radius:999px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font-size:12.5px; font-weight:600; white-space:nowrap; transition:.15s; flex-shrink:0;}
  .tab:hover:not(.active){border-color:var(--accent); color:var(--accent);}
  .tab.active{background:var(--navy); color:#fff; border-color:var(--navy);}
  .tab-dot{width:6px; height:6px; border-radius:50%; background:var(--accent); opacity:.7;}
  .tab.active .tab-dot{background:#8fe3af; opacity:1;}

  /* MAIN */
  main{max-width:1320px; margin:0 auto; padding:20px 18px 40px;}
  .page{display:none;}
  .page.active{display:block;}
  .subpage{display:none;}
  .subpage.active{display:block;}

  /* DIVISION HEADER */
  .div-header{background:linear-gradient(135deg, var(--contract-tint), var(--panel)); border:1px solid var(--line); border-radius:var(--radius); padding:20px 22px; margin-bottom:18px; box-shadow:var(--shadow); display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap;}
  .div-header .left{display:flex; align-items:center; gap:14px; min-width:0;}
  .div-num{font-size:26px; font-weight:800; letter-spacing:-.04em; line-height:1; background:linear-gradient(135deg,#16697a,#0b2239); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; min-width:52px;}
  html.dark .div-num{background:linear-gradient(135deg,#4dc0d4,#8fe3af); -webkit-background-clip:text; background-clip:text;}
  .div-title{font-size:17px; font-weight:700; line-height:1.15;}
  .div-sub{font-size:12px; color:var(--muted); margin-top:3px;}
  .stats{display:flex; gap:8px; flex-wrap:wrap;}
  .stat{background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:6px 12px; text-align:center; min-width:64px;}
  .stat b{display:block; font-size:16px; font-weight:800; line-height:1.1;}
  .stat span{font-size:9.5px; color:var(--muted); font-weight:700; text-transform:uppercase; letter-spacing:.06em; margin-top:2px; display:block;}
  .stat.mat b{color:var(--mat);}
  .stat.sub b{color:var(--sub);}
  .stat.crew b{color:var(--crew);}
  .stat.eq b{color:var(--eq);}

  /* SUB TABS */
  .subtabs{display:inline-flex; gap:4px; background:var(--bg-soft); padding:4px; border-radius:999px; border:1px solid var(--line); margin-bottom:18px; flex-wrap:wrap;}
  .subtab{padding:6px 14px; border-radius:999px; font-size:12px; font-weight:600; color:var(--muted); transition:.15s;}
  .subtab.active{background:var(--panel); color:var(--ink); box-shadow:var(--shadow);}
  .subtab:hover:not(.active){color:var(--ink);}

  /* ACTIVITY CARD */
  .activity{background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); margin-bottom:14px; box-shadow:var(--shadow); overflow:hidden; transition:box-shadow .2s;}
  .activity:hover{box-shadow:var(--shadow2);}
  .act-head{padding:14px 18px; border-bottom:1px solid var(--line); display:flex; align-items:center; gap:12px; flex-wrap:wrap; background:linear-gradient(90deg, rgba(22,105,122,.05), transparent 60%);}
  .act-code{font-family:'SF Mono',Consolas,monospace; font-size:12px; font-weight:700; background:var(--navy); color:#fff; padding:4px 10px; border-radius:6px;}
  html.dark .act-code{background:var(--accent); color:#0b1a2b;}
  .act-name{font-size:14.5px; font-weight:700; line-height:1.25; min-width:0;}
  .act-tags{margin-left:auto; display:flex; gap:5px; flex-wrap:wrap;}
  .tag{font-size:10px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; padding:3px 8px; border-radius:4px;}
  .tag.mat{background:var(--mat-tint); color:var(--mat);}
  .tag.sub{background:var(--sub-tint); color:var(--sub);}
  .tag.crew{background:var(--crew-tint); color:var(--crew);}
  .tag.eq{background:var(--eq-tint); color:var(--eq);}
  .tag.none{background:var(--badge-tint); color:var(--muted);}
  .tag.gold{background:var(--gold-tint); color:var(--gold);}
  .act-body{padding:16px 18px 18px; display:grid; gap:12px; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));}
  .act-body-single{padding:16px 18px 18px; display:flex; flex-direction:column; gap:12px;}

  /* RESOURCE GROUP */
  .res-group{background:var(--bg-soft); border:1px solid var(--line); border-radius:var(--radius-sm); padding:12px 13px;}
  .res-group h4{display:flex; align-items:center; gap:7px; font-size:10.5px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin-bottom:10px;}
  .res-group h4::before{content:""; width:7px; height:7px; border-radius:50%; background:var(--muted);}
  .res-group.g-mat h4::before{background:var(--mat);}
  .res-group.g-sub h4::before{background:var(--sub);}
  .res-group.g-crew h4::before{background:var(--crew);}
  .res-group.g-eq h4::before{background:var(--eq);}
  .res-group h4 .count{margin-left:auto; background:var(--panel); color:var(--muted); padding:1px 7px; border-radius:10px; font-size:10px; border:1px solid var(--line); font-weight:700;}

  /* RESOURCE ITEM */
  .res-item{background:var(--panel); border:1px solid var(--line); border-radius:7px; padding:9px 11px; margin-bottom:6px; border-left:3px solid var(--line); transition:.15s;}
  .res-item:last-child{margin-bottom:0;}
  .res-item.m{border-left-color:var(--mat);}
  .res-item.s{border-left-color:var(--sub);}
  .res-item.c{border-left-color:var(--crew);}
  .res-item.e{border-left-color:var(--eq);}
  .res-item.mod{background:var(--revise-tint); border-color:var(--revise); border-left-color:var(--revise);}
  .res-code{font-family:'SF Mono',Consolas,monospace; font-size:11px; font-weight:700; color:var(--accent);}
  .res-item.mod .res-code{color:var(--revise); text-decoration:line-through; text-decoration-thickness:1px;}
  .res-name{font-size:12.5px; font-weight:600; margin-top:3px; line-height:1.35;}
  .res-meta{font-family:'SF Mono',Consolas,monospace; font-size:10.5px; color:var(--muted); margin-top:3px;}
  .res-empty{font-size:12px; color:var(--muted); font-style:italic; padding:4px 2px;}

  /* MOD NOTE */
  .mod-note{display:inline-flex; align-items:center; gap:5px; background:var(--gold-tint); color:var(--gold); font-size:10px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; padding:3px 8px; border-radius:4px; margin-top:7px; border:1px solid rgba(178,138,56,.25);}
  .mod-note b{font-family:'SF Mono',Consolas,monospace; font-weight:800; text-transform:none; letter-spacing:0;}

  /* CREW COMPOSITION */
  .crew-comp{margin-top:8px; padding:8px 10px; background:var(--bg-soft); border:1px dashed var(--line); border-radius:6px;}
  .crew-comp-title{font-size:9.5px; font-weight:800; color:var(--muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:6px;}
  .crew-comp ul{list-style:none; display:grid; gap:3px 10px; grid-template-columns:1fr;}
  .crew-comp li{font-family:'SF Mono',Consolas,monospace; font-size:11px; display:flex; justify-content:space-between; gap:8px;}
  .crew-comp li span:first-child{color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .crew-comp li span:last-child{font-weight:700; color:var(--crew); flex-shrink:0;}
  @media(min-width:480px){ .crew-comp ul{grid-template-columns:1fr 1fr;} }

  /* VARIANTS */
  .variants{margin-top:6px; padding-left:10px; border-left:2px solid var(--line); font-family:'SF Mono',Consolas,monospace; font-size:10.5px; color:var(--muted);}
  .variants div{padding:2px 0;}

  /* PRINCIPLE BLOCK (used in Lists tab) */
  .principle-block{background:var(--bg-soft); border:1px solid var(--line); border-radius:var(--radius-sm); padding:12px 14px;}
  .principle-block h5{font-size:10.5px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--accent); margin-bottom:8px;}
  .principle-block p{font-size:13px; line-height:1.65; color:var(--ink);}
  .principle-block p + p{margin-top:6px;}
  .principle-block ul{list-style:none; font-size:12.5px; line-height:1.7;}
  .principle-block li{padding:3px 0; padding-left:16px; position:relative;}
  .principle-block li::before{content:"▸"; position:absolute; left:0; color:var(--accent);}
  .principle-block pre{font-family:'SF Mono',Consolas,monospace; font-size:11.5px; line-height:1.6; color:var(--ink); background:var(--panel); padding:10px 12px; border-radius:6px; border:1px solid var(--line); overflow-x:auto; white-space:pre; margin-top:6px;}

  /* QUESTION FLOW (Overview) */
  .q-flow{display:flex; flex-direction:column; gap:8px;}
  .q-step{display:flex; align-items:center; gap:14px; background:var(--panel); border:1px solid var(--line); border-radius:var(--radius-sm); padding:12px 16px;}
  .q-num{width:32px; height:32px; border-radius:50%; background:var(--navy); color:#fff; display:grid; place-items:center; font-weight:800; font-size:13px; flex-shrink:0;}
  html.dark .q-num{background:var(--accent); color:#0b1a2b;}
  .q-body{flex:1; min-width:0;}
  .q-title{font-size:13px; font-weight:700; margin-bottom:3px;}
  .q-target{font-size:11.5px; color:var(--muted); line-height:1.5;}
  .q-arrow{text-align:center; color:var(--muted); font-size:13px; margin:-4px 0; padding-left:15px;}

  /* RESULT CALLOUT */
  .result-callout{background:linear-gradient(135deg, var(--pass-tint), var(--panel)); border:1px solid var(--pass); border-radius:var(--radius); padding:16px 18px;}
  .result-callout h5{font-size:11px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--pass); margin-bottom:10px;}
  .result-callout .formula-line{font-family:'SF Mono',Consolas,monospace; font-size:12.5px; line-height:1.9; color:var(--ink);}

  /* WARN CALLOUT */
  .warn-callout{background:linear-gradient(135deg, var(--gold-tint), var(--panel)); border:1px solid var(--gold); border-radius:var(--radius); padding:16px 18px;}
  .warn-callout h5{font-size:11px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--gold); margin-bottom:10px;}
  .warn-callout p{font-size:13px; line-height:1.65; color:var(--ink);}
  .warn-callout p + p{margin-top:6px;}

  /* TABLE */
  .matrix{width:100%; border-collapse:collapse; font-size:12.5px;}
  .matrix th, .matrix td{text-align:left; padding:9px 12px; border-bottom:1px solid var(--line); vertical-align:top;}
  .matrix th{font-size:10.5px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); background:var(--bg-soft);}
  .matrix tr:last-child td{border-bottom:none;}
  .matrix td:first-child{font-weight:700; color:var(--ink); white-space:nowrap;}
  .matrix-wrap{background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:4px; overflow-x:auto;}

  /* EMPTY */
  .empty{display:none; text-align:center; padding:48px 20px; color:var(--muted); font-size:13px; background:var(--panel); border:1px dashed var(--line); border-radius:var(--radius); margin-bottom:14px;}
  .empty.show{display:block;}
  .empty .big{font-size:32px; margin-bottom:8px; opacity:.4;}

  /* FOOTER */
  .app-footer{max-width:1320px; margin:0 auto; padding:22px 18px 36px; border-top:1px solid var(--line); display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; font-size:11px; color:var(--muted);}
  .app-footer .formula{display:inline-flex; align-items:center; gap:6px; background:var(--bg-soft); border:1px solid var(--line); padding:4px 10px; border-radius:999px; font-family:'SF Mono',Consolas,monospace; font-size:10.5px; color:var(--ink);}

  /* MOBILE */
  @media(max-width:640px){
    .topbar{padding:10px 14px; gap:10px;}
    .brand-mark{width:34px; height:34px; font-size:12px;}
    .brand-title{font-size:13px;}
    .brand-sub{font-size:10px;}
    .tabs{padding:0 14px 10px;}
    .tab{padding:7px 13px; font-size:12px;}
    main{padding:16px 14px 32px;}
    .div-header{padding:16px 16px;}
    .div-num{font-size:22px; min-width:44px;}
    .div-title{font-size:15.5px;}
    .act-head{padding:12px 14px; gap:10px;}
    .act-name{font-size:13.5px; width:100%;}
    .act-tags{margin-left:0; width:100%;}
    .act-body{padding:14px; gap:10px; grid-template-columns:1fr;}
    .act-body-single{padding:14px;}
    .app-footer{padding:18px 14px 30px; flex-direction:column; align-items:flex-start;}
    .q-step{padding:10px 12px; gap:10px;}
    .q-num{width:28px; height:28px; font-size:12px;}
    .q-title{font-size:12.5px;}
    .q-target{font-size:11px;}
  }

  @media print{
    .app-header, .subtabs, .icon-btn, .search{display:none !important;}
    .page, .subpage{display:block !important;}
    .activity{break-inside:avoid; box-shadow:none; border:1px solid #ccc;}
    body{background:#fff; color:#000;}
  }
</style>
</head>
<body>

<header class="app-header">
  <div class="topbar">
    <div class="brand">
      <div class="brand-mark">MEP</div>
      <div>
        <div class="brand-title">MEP Coding System</div>
        <div class="brand-sub">Workbook Logic · Divisions 02 · 04 · 15 &amp; 16</div>
      </div>
    </div>
    <div class="search">
      <svg class="search-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="search" type="search" placeholder="Search activities, resources, codes…" autocomplete="off">
    </div>
    <button class="icon-btn" id="themeToggle" aria-label="Toggle theme">
      <svg class="icon-moon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
    </button>
  </div>
  <nav class="tabs" id="mainTabs">
    <button class="tab active" data-tab="logic"><span class="tab-dot"></span>Workbook Logic</button>
    <button class="tab" data-tab="div02"><span class="tab-dot"></span>02 · Earthwork</button>
    <button class="tab" data-tab="div04"><span class="tab-dot"></span>04 · Blockwork</button>
    <button class="tab" data-tab="div15"><span class="tab-dot"></span>15 · 16 MEP</button>
  </nav>
</header>

<main>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- WORKBOOK LOGIC                                                  -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<section id="logic" class="page active">
  <div class="div-header">
    <div class="left">
      <div class="div-num" style="font-size:32px;">📘</div>
      <div>
        <div class="div-title">The Workbook — Whole Idea</div>
        <div class="div-sub">6 questions · 13 list types · Productivity layer · Architecture</div>
      </div>
    </div>
    <div class="stats">
      <div class="stat crew"><b>143</b><span>Activities</span></div>
      <div class="stat mat"><b>70</b><span>Materials</span></div>
      <div class="stat sub"><b>59</b><span>Subs</span></div>
      <div class="stat crew"><b>19</b><span>Crews</span></div>
      <div class="stat eq"><b>36</b><span>Equip</span></div>
    </div>
  </div>

  <div class="subtabs">
    <button class="subtab active" data-subtab="overview">Overview</button>
    <button class="subtab" data-subtab="lists">13 Lists</button>
    <button class="subtab" data-subtab="productivity">Productivity</button>
    <button class="subtab" data-subtab="architecture">Architecture</button>
    <button class="subtab" data-subtab="example">Worked Example</button>
  </div>

  <!-- ─── OVERVIEW ─── -->
  <div id="sub-overview" class="subpage active">
    <article class="activity">
      <div class="act-head">
        <span class="act-code">01</span>
        <span class="act-name">The whole idea — six questions</span>
        <div class="act-tags"><span class="tag crew">Foundation</span></div>
      </div>
      <div class="act-body-single">
        <div class="q-flow">
          <div class="q-step">
            <div class="q-num">1</div>
            <div class="q-body">
              <div class="q-title">WHAT WORK EXISTS?</div>
              <div class="q-target">→ Activity List CSI</div>
            </div>
          </div>
          <div class="q-arrow">↓</div>
          <div class="q-step">
            <div class="q-num">2</div>
            <div class="q-body">
              <div class="q-title">WHAT RESOURCES DOES EACH ACTIVITY NEED?</div>
              <div class="q-target">→ Mat. List CSI · MP. List CSI · SUBC. List CSI · Equip. List CSI</div>
            </div>
          </div>
